{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
