# Local dev defaults align with docker-compose.yml
DATABASE_URL=postgres://tention:tention@localhost:5432/tention
REDIS_URL=redis://localhost:6379
# Session cookie signing secret (min 32 chars)
SESSION_SECRET=dev_session_secret_change_me_min_32_chars
# AES-256-GCM key: 32 bytes, base64-encoded (used from Phase 2 for connection credentials)
ENCRYPTION_KEY=ZGV2X2VuY3J5cHRpb25fa2V5XzMyX2J5dGVzX2xvbmc=
PORT=3000
NODE_ENV=development
# Base URL the client-facing onboarding link is built from. The token goes in the
# URL FRAGMENT (/onboarding#token=...), which browsers never send to a server, so
# it cannot reach access logs, proxy logs, or a referer header.
APP_BASE_URL=http://localhost:5173
# Shopify webhook HMAC verification (the app's API secret). Set when a real
# Shopify app/store is connected; leave blank for local dev.
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2024-10
# Shopify custom app (client_credentials grant). The Admin API access token is
# minted from these at connect time and auto-refreshed before its ~24h expiry.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Recharge Admin API access token (read-only). Set when connecting a real store.
RECHARGE_API_TOKEN=
RECHARGE_API_VERSION=2021-11
# Klaviyo private API key (pk_…). Read-only scopes required:
#   accounts:read campaigns:read flows:read metrics:read profiles:read
# Leave blank here — the real key belongs in .env only, which is gitignored.
KLAVIYO_API_KEY=
# Newest stable revision supported by every Phase 4 endpoint (never a .pre beta).
KLAVIYO_API_REVISION=2026-07-15
# Optional: pin the conversion metric instead of auto-discovering "Placed Order".
KLAVIYO_CONVERSION_METRIC_ID=
# Reporting API allows a maximum 1-year window. Use a TRAILING window: verified
# live, last_12_months means the 12 COMPLETE calendar months and excludes the
# current month, which leaves this month's campaigns with no stats at all.
KLAVIYO_REPORT_TIMEFRAME=last_365_days
# Identity-graph profile scan budget, in pages of 100 profiles.
KLAVIYO_PROFILE_PAGE_BUDGET=50
